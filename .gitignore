/target

# Local database files created by drsg / just serve, including the native
# LSM engine's on-disk sidecars (HNSW vector index, BM25 keyword index).
*.drsg
*.drsg.jsonl
*.drsg.hnsw
*.drsg.bm25

# Runtime logs from dr-strange-log (DRSG_LOG_DIR, default ./logs) — the server
# writes ./logs relative to its cwd, so ignore the dir anywhere.
logs/

# CodeGraph's local symbol index — a machine-local cache rebuilt from source.
.codegraph/

# The memory layer's per-project runtime dir (scripts/memory-layer): daemon
# address, API token, L3 log. Machine-local, and it holds a secret.
.drsg/

# Python bytecode from the memory layer's hooks and scripts.
__pycache__/
*.pyc

# --- personal workspace only, not part of any upstream PR --------------------
# This machine's Claude Code configuration and design scratch space.
CLAUDE.md
.claude
docs/superpowers/
# Benchmark output: regenerable, and large.
scripts/memory-layer/benchmark/out/
